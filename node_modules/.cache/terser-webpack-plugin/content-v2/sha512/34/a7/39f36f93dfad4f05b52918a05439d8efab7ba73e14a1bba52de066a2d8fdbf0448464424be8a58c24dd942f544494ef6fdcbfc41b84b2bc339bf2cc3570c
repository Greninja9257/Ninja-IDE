ptu\u0000\u0012\u001f-\u001ag\u0006\u001f-/\u000e\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000improper\u0000\u0012\u001f-\u001ag\u0006-\u000f\u0000\u0000\u0000\u0000\u0000\u0002\u0000improve\u0000\u0012\u001f-\u001ag\u000e&\u0000\u0000\u0004\u0000\u0000improvisation\u0000\u0012\u001f-\u001a\u0006&\u0011*g\u0003+\u0012 \u0000\u0000\u0000\u0002\u0000improvise\u0000g\u0002\u001f-\u001a\u0011&\u0007*\u0000\u0001\u0000\u0000\u0000impudent\u0000g\u0002\u001f-\u00100$/\u0000\u0000\u0000\u0000\u0000\u0002\u0000impugn\u0000\u0012\u001f-g\u0010 \u0000\u0000\u0000\u0000\u0004\u0000\u0000impulse\u0000g\u0002\u001f-\t\u001b)\u0000\u0000\u0000\u0002\u0000impute\u0000\u0012\u001f-g\u0010/\u0000\u0000\u0000\u0000\u0010\u0000in\u0000\u0002 \u0000\u0000\u0000\u0000\u0004\u0000\u0000ina\u0000g\u0001 \u0011\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000inaccessible\u0000\u0012 \u00121)g\u0004)\u0011.\"\u0000\u0000\u0000\u0000\u0000\u0004\u0000\u0000inaccuracy\u0000\u0012 g\u00051\u0019\u000f\u0011)\u0001\u0000\u0000\u0000\u0001\u0000\u0000\u0000inaccurate\u0000\u0012 g\u00051\u0019\u000f\u0011/\u0000\u0000\u0000\u0000\u0000\u0000\u0002\u0000inactivate\u0000\u0012 g\u00051/\u0012&\u0003/\u0000\u0000\u0000\u0001\u0000\u0000\u0000inadvertent\u0000\u0012 \u00120&g\u000f/\u0012 /\u0000\u0000\u0004\u0000\u0000inalienability\u0000\u0002 f\u0003\u001b\u0019\u0011 \u0011.g\u0002\u001b\u0012/\u0001\u0000\u0001\u0000\u0000\u0000inalienable\u0000\u0012 g\u0003\u001b\u0019\u0011 \u0011.\"\u0000\u0001\u0000\u0000\u0000inanimate\u0000\u0012 g\u0005 \u0011\u001f\u0011/\u0000\u0001\u0000\u0000\u0000inarticulate\u0000\u0012 \u0006\u001a/g\u00021\u0019\"\u0012/\u0000\u0000\u0000\u0000@\u0000inasmuch\u0000f\u0002 m\u0005*m\u001fg\t6\u0000\u0000\u0000\u0000\u0003\u0000\u0000\u0000inboard\u0000g\u0002 m.\u000b\u001a0\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000inbound\u0000g\u0002 m.\b 0\u0000\u0000\u0000\u0000\u0000\u0000\u0000inbred\u0000g\u0002 .\u001a\u00040\u0000\u0000\u0002\u0000\u0000\u0000Inc.\u0000\u0002 1g\u000b\u001a-\u000f\u0003/\u00120\u0000\u0000\u0000\u0001\u0000\u0000\u0000incalculable\u0000\u0012!1g\u0005\u001b1\u0019\"\u0011.\"\u0000\u0000\u0000\u0000\u0000\u0002\u0000incarcerate\u0000\u0012!1g\u0006\u001a)\u000f\u0003/\u0000\u0000\u0001\u0004\u0000\u0000incendiary\u0000\u0012 )g\u0004 0\u0001\u0003\u001a\u0001\u0000\u0000\u0000\u0000\u0002incense\u0000\u0012 )g\u0004 )\u0000\u0000\u0004\u0000incense\u0000g\u0002 )\u0004 )\u0000\u0000\u0004\u0000\u0000incest\u0000g\u0002 )\u0004)/\u0000\u0000\u0000\u0004\u0002\u0000inch\u0000g\u0002 6\u0000\u0000\u0000\u0000\u0004\u0000\u0000incidence\u0000g\u0002 )\u00120$)\u0000\u0000\u0001\u0004\u0000\u0000incidental\u0000\u0012 )\u00110g\u0004 /\"\u0000\u0000\u0000\u0001\u0000\u0000\u0000incipient\u0000\u0012 )g\u0002-\u0001\u0011 /\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000incisive\u0000\u0012 )g\u0007)\u0012&\u0000\u0000\u0000\u0000\u0004\u0000\u0000incisor\u0000\u0012 )g\u0007*\u000f\u0000\u0001\u0000\u0000\u0000inclement\u0000\u0012!1\u001bg\u0004\u001f\u0011 /\u0000\u0000\u0000\u0000\u0000\u0000\u0002incline\u0000\u0012 1\u001bg\u0007 \u0000\u0000\u0004\u0000incline\u0000g\u0002 1\u001b\u0007 \u0000\u0000\u0000\u0002\u0000include\u0000\u0012!1\u001bg\u000e0\u0000\u0001\u0000\u0000\u0000incognito\u0000\u0012!1\u00062 g\u0001/\u000b\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000incoherent\u0000\u0012!1\u000b\u001cg\u0001\u001a\u0011 /\u0000\u0000\u0000\u0004\u0000\u0000income\u0000g\u0002!1f\t\u001f\u0000\u0000\u0001\u0000\u0000\u0000incommensurate\u0000\u0012!1\u0011\u001fg\u0004 )\u000f\u0012/\u0000\u0001\u0000\u0000\u0000incommunicable\u0000\u0012!1\u0011\u001fg\u0010 \u00121\u0011.\"\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000incomparable\u0000\u0012!1g\u0006\u001f-\u000f\u0011.\"\u0000\u0000\u0000\u0000\u0000\u0004\u0000\u0000incompetence\u0000\u0012!1g\u0006\u001f-\u0011/\u0012 )\u0000\u0000\u0000\u0000\u0004\u0000\u0000incompetency\u0000f\u0002 1g\u0006\u001f-\u0011/\u0012 )\u0001\u0000\u0001\u0000\u0000\u0000incompetent\u0000\u0012!1g\u0006\u001f-\u0011/\u0012 /\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000incomprehensible\u0000\u0012!1\u0006\u001f-\u001a\u0001\u001cg\u0004 )\u0011.\"\u0000\u0000\u0000\u0001\u0000\u0000\u0000incongruous\u0000\u0012!1g\u0006!2\u001a\u000e\u0011)\u0000\u0001\u0004\u0000\u0000inconsequential\u0000\u0012!1\u0006 )\u00121\u0018g\u0004 +\"\u0000\u0000\u0001\u0000\u0000\u0000inconsiderable\u0000\u0012!1\u0012 )g\u00020\u000f\u0011.\"\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000inconsiderate\u0000\u0012!1\u0012 )g\u00020\u000f\u0012/\u0000\u0000\u0001\u0000\u0000\u0000inconstant\u0000\u0012!1g\u0006 )/\u0012 /\u0000\u0000\u0001\u0000\u0000\u0000incontinent\u0000\u0012!1g\u0006 /\u0012 \u0012 /\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000incontrovertible\u0000\u0012!1\u0006 /\u001a\u0011&g\u000f/\u0011.\"\u0000\u0000\u0000\u0000\u0000\u0000\u0002\u0000incorporate\u0000\u0012!1g\\n\u001a-\u000ff\u0003/\u0000\u0001\u0000\u0000\u0000incorrigible\u0000\u0012!1g\u000b\u001a\u00117\u0012.\"\u0000\u0000\u0000\u0000\u0000\u0000\u0002increase\u0000\u0002 1\u001ag\u0001)\u0000\u0000\u0000\u0000\u0000\u0004\u0000increase\u0000g\u0002 1\u001a\u0001)\u0000\u0000\u0000\u0000\u0000\u0000\u0002\u0000incubate\u0000g\u0002!1\u0010.\u0003/\u0000\u0000\u0000\u0000\u0000\u0002\u0000incur\u0000\u0012!1g\u000f\u0000\u0001\u0004\u0000\u0000incurable\u0000\u0012!1\u0019g\u000f\u0011.\"\u0000\u0001\u0000\u0000\u0000indecipherable\u0000\u0012 0\u0012)g\u0007%\u000f\u0011.\"\u0000\u0000\u0004\u0000\u0000indecision\u0000\u0012 0\u0012)g\u0002,\u0012 \u0000\u0000\u0000\u0001\u0000\u0000\u0000indecisive\u0000\u0012 0\u0012)g\u0007)\u0012&\u0000\u0000\u0000\u0002\u0000\u0000\u0000indeed\u0000\u0012 0g\u00010\u0000\u0000\u0000\u0001\u0000\u0000\u0000indefatigable\u0000\u0012 0\u0012%g\u0005/\u00122\u0011.\"\u0000\u0001\u0000\u0000\u0000indefinable\u0000\u0012 0\u0012%g\u0007 \u0011.\"\u0000\u0001\u0000\u0000\u0000indefinite\u0000\u0012 0