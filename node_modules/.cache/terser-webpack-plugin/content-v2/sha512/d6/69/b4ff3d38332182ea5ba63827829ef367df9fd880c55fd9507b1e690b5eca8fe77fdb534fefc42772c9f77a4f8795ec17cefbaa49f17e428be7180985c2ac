r\n                    }\r\n                };\r\n\r\n                processItem(list);\r\n\r\n                return flattenedList.join(', ');\r\n            };\r\n\r\n            const list = JSON.parse(LIST);\r\n            const flattenedList = flatten(list);\r\n            return flattenedList;\r\n        }\r\n\r\n        createBlankList() {\r\n            return '[]';\r\n        }\r\n\r\n        deleteItem({ INDEX, LIST }) {\r\n            if (!this.isList(LIST)) return;\r\n\r\n            const index = Math.max(1, Math.floor(INDEX));\r\n            const list = JSON.parse(LIST);\r\n            if (Array.isArray(list) && index <= list.length) {\r\n                list.splice(index - 1, 1);\r\n                return JSON.stringify(list);\r\n            }\r\n            return null;\r\n        }\r\n\r\n        replaceItem({ INDEX, LIST, ITEM }) {\r\n            if (!this.isList(LIST)) return;\r\n\r\n            const index = Math.max(1, Math.floor(INDEX));\r\n            const item = ITEM;\r\n            const list = JSON.parse(LIST);\r\n            if (Array.isArray(list) && index <= list.length) {\r\n                list[index - 1] = item;\r\n                return JSON.stringify(list);\r\n            }\r\n            return null;\r\n        }\r\n\r\n        listContains({ LIST, ITEM }) {\r\n            if (!this.isList(LIST)) return;\r\n\r\n            const item = ITEM;\r\n            const list = JSON.parse(LIST);\r\n            if (Array.isArray(list)) {\r\n                return list.includes(item);\r\n            }\r\n            return false;\r\n        }\r\n\r\n        itemIndex({ ITEM, LIST}) {\r\n            if (!this.isList(LIST)) return;\r\n\r\n            const item = ITEM;\r\n            const list = JSON.parse(LIST);\r\n\r\n            if (Array.isArray(list)) {\r\n                const index = list.findIndex((element) => element === item);\r\n                return index + 1;\r\n            }\r\n\r\n            return 0;\r\n        }\r\n\r\n        listLength({ LIST }) {\r\n            if (!this.isList(LIST)) return;\r\n\r\n            const list = JSON.parse(LIST);\r\n            if (Array.isArray(list)) {\r\n                return list.length;\r\n            }\r\n            return 0;\r\n        }\r\n    }\r\n\r\n    Scratch.extensions.register(new ListPlus());\r\n})(Scratch);\r\n","inputSourceMap":null}